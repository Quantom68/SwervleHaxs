{
    "manifest_version": 3,
    "name": "Swervle Tas",
    "description": "tba",
    "version": "0.0.3",
    "permissions": ["declarativeNetRequest"],
    "host_permissions": ["https://swervle.com/*"],
    "declarative_net_request": {
        "rule_resources": [
        {
            "id": "swervle_patch",
            "enabled": true,
            "path": "rules.json"
        }
        ]
    },
    "web_accessible_resources": [
        {
        "resources": ["patched-bundle.js", "patched-replay.js"],
        "matches": ["https://swervle.com/*"]
        }
    ]
}
