{
    "manifest_version": 3,
    "name": "Swervle Tas Tool",
    "description": "tba",
    "version": "0.2.0",
    "permissions": ["declarativeNetRequest"],
    "host_permissions": ["https://swervle.com/*"],
    "content_scripts": [
        {
        "matches": ["https://swervle.com/*"],
        "js": ["anti-auto-pause.js"],
        "run_at": "document_start",
        "world": "MAIN"
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
        {
            "id": "swervle_patch",
            "enabled": true,
            "path": "rules.json"
        }
        ]
    },
    "web_accessible_resources": [
        {
        "resources": ["patched-bundle.js", "patched-replay.js"],
        "matches": ["https://swervle.com/*"]
        }
    ]
}
