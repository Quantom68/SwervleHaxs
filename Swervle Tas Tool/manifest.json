{
    "manifest_version": 3,
    "name": "Swervle Tas Tool",
    "description": "tba",
    "version": "2.0.0",
    "permissions": [
        "declarativeNetRequest",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://swervle.com/*",
        "https://raw.githubusercontent.com/*",
        "https://cdn.jsdelivr.net/*",
        "https://api.github.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Swervle Haxs — badge shows patch-sync status (blank = ok, ! = some patches skipped upstream, X = couldn't reach GitHub)"
    },
    "content_scripts": [
        {
        "matches": ["https://swervle.com/*"],
        "js": ["anti-auto-pause.js"],
        "run_at": "document_start",
        "world": "MAIN"
        },
        {
        "matches": ["https://swervle.com/*"],
        "js": ["draggable.js", "overlay.js"],
        "css": ["overlay.css"],
        "run_at": "document_start",
        "world": "MAIN"
        }
    ]
}
