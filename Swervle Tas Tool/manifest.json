{
    "manifest_version": 3,
    "name": "Swervle Tas Tool",
    "description": "tba",
    "version": "0.2.4",
    "permissions": [
        "declarativeNetRequest",
        "activeTab",
        "scripting"
    ],
    "declarative_net_request": {
        "rule_resources": [
        {
            "id": "swervle_patch",
            "enabled": true,
            "path": "rules.json"
        }
        ]
    },
    "web_accessible_resources": [
        {
        "resources": ["patched-bundle.js", "patched-replay.js"],
        "matches": ["https://swervle.com/*"]
        }
    ]
}
