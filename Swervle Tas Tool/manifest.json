{
    "manifest_version": 3,
    "name": "Swervle Tas Tool",
    "description": "tba",
    "version": "1.2.2",
    "permissions": [
        "declarativeNetRequest",
        "activeTab",
        "scripting"
    ],
    "host_permissions": ["https://swervle.com/*"],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
        "matches": ["https://swervle.com/*"],
        "js": ["anti-auto-pause.js"],
        "run_at": "document_start",
        "world": "MAIN"
        },
        {
        "matches": ["https://swervle.com/*"],
        "js": ["draggable.js", "overlay.js"],
        "css": ["overlay.css"],
        "run_at": "document_start",
        "world": "MAIN"
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
        {
            "id": "swervle_patch",
            "enabled": true,
            "path": "rules.json"
        }
        ]
    },
    "web_accessible_resources": [
        {
        "resources": ["patched-bundle.js", "patched-replay.js"],
        "matches": ["https://swervle.com/*"]
        }
    ]
}
